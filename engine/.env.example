# Copy to engine/.env and fill in what you have. Everything is optional — the
# pipeline runs with local fallbacks when a key is missing.

# AI conversational-structure annotation (anticipation cuts get smarter).
ANTHROPIC_API_KEY=
PODCUT_ANNOTATE_MODEL=claude-haiku-4-5-20251001

# Transcription (pick one; ElevenLabs also gives speaker diarization).
ELEVENLABS_API_KEY=
PODCUT_ELEVENLABS_MODEL=scribe_v1
# PODCUT_NUM_SPEAKERS=2      # optional hint: expected number of speakers
OPENAI_API_KEY=
# Or install faster-whisper for local transcription: pip install faster-whisper
PODCUT_WHISPER_MODEL=base

# External editors (leave blank to skip these steps).
VIDEO_USE_PATH=
HYPERFRAMES_PATH=
