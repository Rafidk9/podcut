# Cloud UI credentials. Copy to cloud/.env.local for local dev, and set the same
# two variables in Cloudflare Pages -> Settings -> Environment variables.
#
# These are baked into the static bundle at build time. That is fine: the anon
# key is public by design and every table is behind row-level security that
# checks the signed-in email against public.allowed_user(). The service key is
# NOT used here -- only worker/.env holds that.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
