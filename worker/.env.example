# PodCut render worker -- copy to worker/.env and fill in.
# worker/.env is gitignored by the repo-wide "**/.env" rule. Do not commit it:
# the service key below bypasses row-level security entirely.

# Supabase project settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The SERVICE ROLE key, not the anon key. Only this machine ever sees it.
SUPABASE_SERVICE_KEY=

# --- Optional -------------------------------------------------------------

# Storage bucket for deliverables. Must match supabase/schema.sql.
# SUPABASE_BUCKET=deliverables

# Repo root. Defaults to the parent of worker/, which is right for a normal
# checkout -- set it only if you run the worker from somewhere else.
# PODCUT_ROOT=C:\Users\you\Downloads\podcut\podcut

# Interpreter used for the pipeline. Defaults to engine/.venv, falling back to
# whatever python is running the worker. Point this at an interpreter that has
# rembg installed if your reels use bg_swap.py.
# PODCUT_PYTHON=C:\Users\you\Downloads\podcut\podcut\engine\.venv\Scripts\python.exe

# Refuse to start a build below this much free disk. A build needs ~2 GB of
# work/ scratch, and a full disk shows up as a hang, not an error.
# MIN_FREE_GB=10

# How many reels' deliverables to keep mirrored in Supabase Storage.
# The free tier is 1 GB and a reel is ~26 MB.
# PRUNE_KEEP=20

# Seconds between queue polls.
# POLL_SECONDS=5
