# Python
engine/.venv/
__pycache__/
*.pyc
engine/.env
# .podcut_work is scratch working audio/video for a run and can carry a
# per-source suffix (e.g. .podcut_work_P1 for input clip "P1") -- match all
# variants, not just the bare name, or per-clip runs leak real client audio.
.podcut_work*/
engine/.podcut_work*/
engine/.podcut_jobs/

# Node / Next
node_modules/
web/.next/
web/out/
cloud/.next/
cloud/out/
# Cloudflare Pages / Wrangler scratch
.wrangler/

# Secrets -- any .env anywhere, not just engine/.env (e.g. nested tool checkouts
# under sample/work dirs can carry their own)
**/.env
!**/.env.example

# Media artifacts
sample/
real_sample/
*.mp4
*.mov
*.MOV
!**/README*
# ...except the shared brand end-card videos build_composite.py requires --
# these are small finished brand assets, not raw/client footage.
!assets/endcards/*.mp4

# Raw client footage / per-reel working data: the shared pipeline scripts +
# README (which live directly in reels/, not a subfolder) are source-
# controlled here, as usual. Every reel folder -- dated (<YYYY-MM-DD>_<slug>/)
# or not -- holds real client input/intermediates/deliverables and those must
# never be committed.
#
# The lightweight EDITORIAL CONFIG is the exception: content.json, clips.json,
# broll_plan.json, and any per-reel broll.py/bg_swap.py are the actual
# creative decisions (timing, copy, layout) behind a reel, carry no raw media,
# and are the one thing worth surviving a deleted worktree or a lost laptop --
# which nearly happened once. Everything else in a reel folder (input/, work/,
# output/, assets/, documents/) stays untracked.
reels/*/*
!reels/*/content.json
!reels/*/clips.json
!reels/*/broll_plan.json
!reels/*/broll.py
!reels/*/bg_swap.py
# reels/tests/ is shared test infra, not a per-reel folder -- the wildcard
# above would otherwise sweep it up too since "tests" matches reels/*/*.
# Only .py files, not __pycache__ (still caught by the blanket rule up top).
!reels/tests/
!reels/tests/*.py

# HyperFrames video projects (videos/<project-name>/): track the composition
# source (index.html, shot-plan.json, meta.json, hyperframes.json,
# package.json, AGENTS.md/CLAUDE.md, assets/) same as a reel's editorial
# config. Don't track generated/regenerable output: Studio's preview cache,
# proof snapshots (regenerate via `npx hyperframes snapshot`), and rendered
# video (*.mp4/*.mov already ignored above; .webm alpha-overlay exports too).
videos/*/.thumbnails/
videos/*/snapshots/
videos/*/renders/
videos/*/*.webm
