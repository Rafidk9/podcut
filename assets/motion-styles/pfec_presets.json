  "motion-halftone":      {"colors": {"bg": "FFF8E6", "c1": "00B3E3", "c2": "FFC500", "c3": "100796"}, "example": {"text": "BIG NEWS", "sub": "for 189 applicants"}, "notes": "everything is dots"},
  "motion-holographic":   {"colors": {"bg": "F2F1FA", "c1": "00B3E3", "c2": "31EB7C", "c3": "FFC500"}, "example": {"text": "PFEC", "sub": "PFEC GLOBAL"}, "notes": "don't pair with neon"},
  "motion-isometric":     {"colors": {"bg": "F2F1FA", "c1": "FFC500", "c2": "100796", "c3": "BFEFFF"}, "example": {"text": "7 OFFICES", "sub": "ACROSS AUSTRALIA"}, "notes": "orthographic only"},
  "motion-kinetic-type":  {"colors": {"bg": "100796", "c1": "FFC500", "c2": "FFFFFF", "c3": "100796"}, "example": {"text": "YOUR VISA STARTS HERE", "sub": "PFEC GLOBAL"}, "notes": "2-6 words, none over 10 characters; final word lands on a light card"},
  "motion-liquid-morph":  {"colors": {"bg": "100796", "c1": "00B3E3", "c2": "31EB7C", "c3": "FFC500"}, "example": {"text": "", "sub": ""}, "notes": "abstract; best as a short transition/B-roll"},
  "motion-neo-brutalism": {"colors": {"bg": "FFC500", "c1": "E84B37", "c2": "00B3E3", "c3": "31EB7C"}, "example": {"text": "FREE CONSULT", "sub": "7 OFFICES AUSTRALIA-WIDE"}, "notes": "first number in sub counts up; arial-black face kept for the brutalist look", "replace": {"'CLICK ME →'": "'BOOK NOW →'"}},
