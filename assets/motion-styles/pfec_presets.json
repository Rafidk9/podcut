{
  "_doc": "PFEC brand colour map per motion style, applied by reels/motion_style.py unless --no-brand. Keys are each template's own colour slots (see that style's SKILL.md 'This style:' line). Values stay on the brand palette -- navy #100796, gold #FFC500, cyan #00B3E3, green #31EB7C, red #E84B37, white -- plus deeper/lighter tints of those only where a template needs a shade (flap faces, back lines, highlights). 'example' is a sample text/sub for test renders; 'notes' carries the style's fit limits.",
  "motion-art-deco":      {"colors": {"bg": "0a0560", "c1": "FFC500", "c2": "FFE27A", "c3": "B38A00"}, "example": {"text": "PFEC", "sub": "SINCE 2008"}, "notes": "hero word 3-8 letters; serif face kept on purpose"},
  "motion-ascii-art":     {"colors": {"bg": "07043a", "c1": "31EB7C", "c2": "00B3E3", "c3": "FFFFFF"}, "example": {"text": "> ask pfec_", "sub": "visa options loading..."}, "notes": "mono face kept on purpose"},
  "motion-bauhaus":       {"colors": {"bg": "F4F3FB", "c1": "E84B37", "c2": "FFC500", "c3": "100796", "c4": "0a0560"}, "example": {"text": "your pathway", "sub": "study · work · stay"}, "notes": "title is lowercase by design"},
  "motion-blueprint":     {"colors": {"bg": "100796", "c1": "FFFFFF", "c2": "00B3E3", "c3": "FFC500"}, "example": {"text": "VISA PATHWAY", "sub": "PLAN NO. 189 · STEP BY STEP"}, "notes": "line-only look"},
  "motion-clay-3d":       {"colors": {"bg": "F2F1FA", "c1": "00B3E3", "c2": "FFC500", "c3": "31EB7C"}, "example": {"text": "Study in Australia", "sub": "PFEC Global"}, "notes": "soft, friendly; good for student content"},
  "motion-comic-book":    {"colors": {"bg": "FFF8E6", "c1": "FFC500", "c2": "E84B37", "c3": "00B3E3"}, "example": {"text": "BOOM!", "sub": "Visa granted!"}, "notes": "text = SFX word, sub = speech bubble"},
  "motion-glassmorphism": {"colors": {"bg": "100796", "c1": "00B3E3", "c2": "E84B37", "c3": "FFC500"}, "example": {"text": "Book a consultation", "sub": "PFEC Global"}, "notes": "needs colour behind the glass -- don't use a flat bg; upstream demo widgets (Dubai weather, 8,240 daily-goal stat) are swapped via replace -- never ship an invented stat", "replace": {"'Dubai'": "'Sydney'", "'Focus'": "'Alerts'", "'Daily goal'": "'Offices'", "lerp(0, 8240,": "lerp(0, 7,"}},
